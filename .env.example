# Compose builds DATABASE_URL from POSTGRES_PASSWORD; set DATABASE_URL directly when
# running outside Docker.
POSTGRES_PASSWORD=the_way
DATABASE_URL=postgresql+asyncpg://the_way:the_way@localhost:5432/the_way

REDIS_URL=redis://localhost:6379/0

TASKIQ_BROKER_URL=redis://localhost:6380/0
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6380/1

CRYPTOGRAPHY_FERNET_KEY=
REQUEST_SIGNING_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev@localhost
SMTP_PASSWORD=dev

BUCKET_NAME=the-way
BUCKET_PREFIX=the_way
BUCKET_ENDPOINT=http://localhost:9090
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=the_way
BUCKET_SECRET_ACCESS_KEY=the_way_secret
# The bucket as a client (browser, desktop app) reaches it: presigned URLs are signed for
# this address. Locally the published S3 port; deployed, the bucket's public address
# (e.g. https://the-way.s3.us-east-1.amazonaws.com). Leave unset to use BUCKET_ENDPOINT.
BUCKET_PUBLIC_ENDPOINT=http://127.0.0.1:9090

# The API as clients reach it. Images in HTML pages are linked through it, so it must be
# the address users' machines can open -- locally http://localhost:8000, deployed the
# public URL (e.g. https://api.example.com).
PUBLIC_API_URL=http://localhost:8000
# Signs those image links. They never expire, so changing it breaks every one already
# written into a page. Leave unset to use REQUEST_SIGNING_SECRET.
FILE_LINK_SECRET=

CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# Set to a Docker Hub tag to run published images instead of building locally,
# for example APP_IMAGE=yourname/the-way:1.0.0
APP_IMAGE=the-way:local

INVITATION_ACCEPT_URL=http://localhost:3000/accept-invite

# Cookies are Secure by default; local development over plain http needs false.
SESSION_COOKIE_SECURE=true
