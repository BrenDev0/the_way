# Grouped by service, as docker-compose.yml and src/core/settings/ are. A deployment sets the
# same names on each service: the shared block on both api and worker, then each service's own.
#
#   migrate   DATABASE_URL only
#   api       SHARED + API
#   worker    SHARED + WORKER
#   render    RENDER_SHARED_SECRET only (it is given none of the app's secrets)

# ===== SHARED: the api and the worker both need these ====================================

# Compose builds DATABASE_URL from POSTGRES_PASSWORD; set DATABASE_URL directly when
# running outside Docker.
POSTGRES_PASSWORD=the_way
DATABASE_URL=postgresql+asyncpg://the_way:the_way@localhost:5432/the_way

REDIS_URL=redis://localhost:6379/0

TASKIQ_BROKER_URL=redis://localhost:6380/0
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6380/1

CRYPTOGRAPHY_FERNET_KEY=
REQUEST_SIGNING_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev@localhost
SMTP_PASSWORD=dev

BUCKET_NAME=the-way
BUCKET_PREFIX=the_way
BUCKET_ENDPOINT=http://localhost:9090
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY_ID=the_way
BUCKET_SECRET_ACCESS_KEY=the_way_secret
# The bucket as a client (browser, desktop app) reaches it: presigned URLs are signed for
# this address. Locally the published S3 port; deployed, the bucket's public address
# (e.g. https://the-way.s3.us-east-1.amazonaws.com). Leave unset to use BUCKET_ENDPOINT.
BUCKET_PUBLIC_ENDPOINT=http://127.0.0.1:9090

# The API as clients reach it. Images in HTML pages are linked through it, so it must be
# the address users' machines can open -- locally http://localhost:8000, deployed the
# public URL (e.g. https://api.example.com).
PUBLIC_API_URL=http://localhost:8000
# Signs those image links. They never expire, so changing it breaks every one already
# written into a page. Leave unset to use REQUEST_SIGNING_SECRET.
FILE_LINK_SECRET=

# The render service as the api and the worker reach it, with the secret it checks. Inside
# compose RENDER_URL is http://render:8100 (set by docker-compose.yml; the service publishes no
# port, so there is nothing to put here); deployed, its private address. The secret is any
# long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))". The
# SAME secret goes on the render service below.
RENDER_SHARED_SECRET=

# Local only: set to a Docker Hub tag to run published images instead of building locally,
# for example APP_IMAGE=yourname/the-way:1.0.0
APP_IMAGE=the-way:local

# ===== API: only the api reads these (every one has a default) =============================

CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# Cookies are Secure by default; local development over plain http needs false.
SESSION_COOKIE_SECURE=true

# Where the links in invitation emails land: a page that takes ?token= and a password.
INVITATION_ACCEPT_URL=http://localhost:3000/accept-invite
# The same for an owner invitation from Xplorers (starts an organization).
OWNER_INVITATION_ACCEPT_URL=http://localhost:3000/accept-owner-invite

# Also settable on the api, with defaults in src/core/settings/api.py: DESKTOP_DOWNLOAD_PAGE_URL,
# SESSION_COOKIE_NAME / _SAMESITE, SESSION_TTL_SECONDS, DESKTOP_SESSION_TTL_SECONDS,
# DESKTOP_LOGIN_*, RATE_LIMIT_*, PUBLIC_PROXY_HOPS, WEB_PROXY_HOPS, REQUEST_SIGNATURE_WINDOW_SECONDS.

# ===== WORKER: only the worker reads these ================================================

# Tasks run at once (conversation turns, document ingestions, background jobs), and threads
# for CPU-heavy work: flags to `taskiq worker` in docker-compose.yml.
TASKIQ_MAX_ASYNC_TASKS=50
TASKIQ_MAX_THREADPOOL_THREADS=8
# Its database pool is sized to match -- keep worker pool + overflow + the api's
# (DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW, 10 + 20 by default) under Postgres's
# max_connections (100). With more worker containers, divide accordingly. On the worker
# these are given to the service as DATABASE_POOL_SIZE and DATABASE_MAX_OVERFLOW.
WORKER_DATABASE_POOL_SIZE=25
WORKER_DATABASE_MAX_OVERFLOW=30
# Also settable on the worker, with defaults in src/core/settings/worker.py:
# TASKIQ_XREAD_BLOCK_MS, TASKIQ_SOCKET_TIMEOUT_SECONDS, TASKIQ_IDLE_TIMEOUT_SECONDS,
# TASKIQ_HEARTBEAT_SECONDS, TASKIQ_HEARTBEAT_MAX_SECONDS.

# ===== RENDER: a real Chromium (src/render), given none of the above ======================

# RENDER_SHARED_SECRET (above) is the only one it needs. Optional, with defaults in
# src/core/settings/render.py: RENDER_TIMEOUT_SECONDS, RENDER_MAX_CONCURRENT,
# RENDER_RESTART_AFTER.
# Its image, built from the Dockerfile's `render` stage. A Docker Hub tag to run a
# published one instead of building locally.
RENDER_IMAGE=the-way-render:local
